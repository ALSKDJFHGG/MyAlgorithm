{
    "tasks": [
        {
            "type": "process",
            "label": "C/C++: clang++ x64 (Debug)",
            "command": "E:/Scoop/apps/llvm/current/bin/clang++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++20",
                // 切换到 MinGW target，使用 GNU 标准库 libstdc++
                "--target=x86_64-w64-windows-gnu",
                "-stdlib=libstdc++",
                "${file}",
                "-o",
                "${workspaceFolder}\\bin\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "使用 Clang++ 编译当前文件 (Debug)"
        },
        {
            "type": "process",
            "label": "C/C++: clang++ x64 (Release)",
            "command": "E:/Scoop/apps/llvm/current/bin/clang++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-O1",
                "-std=c++20",
                // 切换到 MinGW target，使用 GNU 标准库 libstdc++
                "--target=x86_64-w64-windows-gnu",
                "-stdlib=libstdc++",
                "${file}",
                "-o",
                "${workspaceFolder}\\bin\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "使用 Clang++ 编译当前文件 (Release)"
        },
        {
            "label": "清理构建文件",
            "type": "shell",
            "command": "del",
            "args": [
                "${workspaceFolder}\\bin\\${fileBasenameNoExtension}.exe"
            ],
            "group": {
                "kind": "none"
            },
            "problemMatcher": []
        },
        {
            "label": "运行x64文件",
            "type": "shell",
            "dependsOn": [
                "C/C++: clang++ x64 (Release)"
            ],
            "command": "${workspaceFolder}\\bin\\${fileBasenameNoExtension}.exe",
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "new"
            }
        }
    ],
    "version": "2.0.0"
}
