{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe x64 (Debug)",
            "command": "I:\\works\\mingw64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${workspaceFolder}\\include\\*.h",
                "${file}",
                "-o",
                "${workspaceFolder}\\bin\\${fileBasenameNoExtension}.exe",
                "-fexec-charset=GB18030"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "调试器生成的任务。"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe x64 (Release)",
            "command": "I:\\works\\mingw64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-O1",
                "${workspaceFolder}\\include\\*.h",
                "${file}",
                "-o",
                "${workspaceFolder}\\bin\\${fileBasenameNoExtension}.exe",
                "-fexec-charset=GB18030"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "调试器生成的任务。"
        },
        {
            "label": "清理构建文件",
            "type": "shell",
            "command": "del ${workspaceFolder}\\bin\\${fileBasenameNoExtension}.exe",
            "group": {
                "kind": "none"
            },
            "problemMatcher": []
        },
        {
            "label": "运行x64文件",
            "type": "shell",
            "dependsOn": [
                "C/C++: g++.exe x64活动文件 (Release)"
            ],
            "command": "${workspaceFolder}\\bin\\${fileBasenameNoExtension}.exe",
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "new"
            }
        }
    ],
    "version": "2.0.0"
}